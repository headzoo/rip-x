# X API v2 app-only bearer token from the X Developer Console.
# Keep this server-only: do not rename it with a NEXT_PUBLIC_ prefix.
X_API_BEARER_TOKEN=

# Cache successful X profile + timeline lookups for one hour.
# Optional; defaults to 3600. Set to 0 to disable. No cache credentials needed.
X_CACHE_TTL_SECONDS=3600

# OpenAI API key from the OpenAI Developer Console.
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
