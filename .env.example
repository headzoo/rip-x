# X API v2 app-only bearer token from the X Developer Console.
# Keep this server-only: do not rename it with a NEXT_PUBLIC_ prefix.
X_API_BEARER_TOKEN=

# Cache successful X profile + timeline lookups for one hour.
# Optional; defaults to 3600. Set to 0 to disable. No cache credentials needed.
X_CACHE_TTL_SECONDS=3600

# OpenAI API key from the OpenAI Developer Console.
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# Neon pooled connection for requests; direct/unpooled connection for Prisma CLI.
# Use separate Neon branches for development/preview and production.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Existing mosslings-blob store. All RIP-X files live under rip-x/hauntings/.
# Token is READ_WRITE (not BLOG_READ_WRITE_TOKEN). Never NEXT_PUBLIC_*.
# This implementation requires a PUBLIC Blob store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
